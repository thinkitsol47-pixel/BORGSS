# Copy to `.env.local` and fill in. Never commit the filled copy.

# ── Public ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_JOURNAL_NAME="Blue Ocean Research Journal for Social Sciences"

# ── Database (Supabase Postgres) ───────────────────────
# Both come from Supabase → Settings → Database → Connection string.
#
# DATABASE_URL is the **pooled** connection (port 6543, "Transaction" mode).
# Serverless functions open a connection per invocation, and the pooler is what
# stops that exhausting Postgres. Add `?pgbouncer=true` to the end.
#
# DIRECT_URL is the **direct** connection (port 5432). Prisma migrations need
# it, because the pooler cannot run the statements a migration issues.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:5432/postgres"

# ── Supabase (auth) ────────────────────────────────────
# From Supabase → Settings → API. Files do NOT live here — see Cloudinary below.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Bypasses row-level security, so it must never reach the browser
# and must never be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# ── File storage (Cloudinary) ──────────────────────────
# From Cloudinary → Settings → API Keys. Chosen over Supabase Storage for its
# 25 GB free tier.
#
# **Read this before writing an upload.** Cloudinary's default is a permanently
# public URL: anyone with the link opens the file, forever. A manuscript under
# review is confidential, so every upload must pass
#   { resource_type: "raw", type: "authenticated" }
# and every read must mint a short-lived signed URL *after* checking the reader
# is entitled to that file. Never store a signed URL or put one in an email —
# it is a bearer token. `docs/BACKEND-PLAN.md` has the code.
#
# All three are server-only. None may be prefixed NEXT_PUBLIC_: the API secret
# in the browser lets anyone sign their own URLs for any file in the account.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Email (Resend; Brevo is the fallback) ──────────────
RESEND_API_KEY=""
EMAIL_FROM="editorial@blueoceanresearchjournal.org"

# ── ORCID ──────────────────────────────────────────────
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""

# ── Crossref ───────────────────────────────────────────
# The journal has no prefix yet, so every DOI reads 10.xxxxx and resolves
# nowhere. `hasCrossrefPrefix()` derives that from the value, so the warning on
# /admin/doi disappears by itself once a real prefix lands here.
CROSSREF_DEPOSIT_USER=""
CROSSREF_DEPOSIT_PASSWORD=""
CROSSREF_DOI_PREFIX="10.xxxxx"

# ── ISR revalidation ───────────────────────────────────
REVALIDATE_SECRET="change-me"

# -- Keep-alive cron ------------------------------------
# Vercel calls /api/keep-alive once a day so the free Supabase project is never
# paused for inactivity. Vercel sends this value as a Bearer token; without it
# the route refuses every call and the database can be paused again.
# Any long random string. Set it in Vercel → Settings → Environment Variables.
CRON_SECRET=""

# -- Audits ---------------------------------------------
# The structural audits sign in for real, because portal routes are guarded.
# Use a super-admin account: it is the only role that reaches every screen.
AUDIT_EMAIL=""
AUDIT_PASSWORD=""
